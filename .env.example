# Lawgic FEK pipeline — environment template.
# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.
# The Electron shell passes these to the Python core as env vars; or set them
# in your shell. Names match lawgic_pipeline/config.py.

# --- Weaviate (the Jun2026* collections live on this cluster) ---
WEAVIATE_URL=https://dxyeak9tnm4gp8raeh1g.c0.europe-west3.gcp.weaviate.cloud
WEAVIATE_API_KEY=

# --- Voyage (voyage-context-3 embeddings, rerank-2.5) ---
VOYAGE_API_KEY=

# --- Azure Document Intelligence (table-page extraction) ---
DI_ENDPOINT=
DI_KEY=

# --- LLM enrichment (summary / keywords / EUROVOC / ΔΚΝ) ---
# Provider-agnostic: anthropic | deepseek | openai
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_THINKING=off
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Pipeline ---
JURISDICTION=gr
STATE_DB=lawgic_state.db
CONCURRENCY=4
